            "value" : "Denne appen bruker posisjon til å vise hvor du er på kartet og registrere aktiviteter, også når appen er i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app gebruikt je locatie om je positie op de kaart te tonen en activiteiten op te nemen, ook als de app op de achtergrond draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja używa lokalizacji, aby pokazywać Twoją pozycję na mapie i rejestrować aktywności, również gdy działa w tle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app usa a localização para mostrar a sua posição no mapa e gravar atividades, incluindo quando a app está em segundo plano."
