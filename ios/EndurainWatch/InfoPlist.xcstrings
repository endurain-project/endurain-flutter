{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Health read permission prompt. 'Health' is Apple's Health app.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain чете пулса, разстоянието и енергията ви по време на тренировка, за да ги показва в реално време и да добавя пулса към маршрута ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain llegeix la vostra freqüència cardíaca, distància i energia durant un entrenament per mostrar-les en directe i afegir la freqüència cardíaca a la vostra ruta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain během tréninku čte váš tep, vzdálenost a energii, aby je zobrazoval živě a přidal tep k vaší trase."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain læser din puls, distance og energi under en træning for at vise dem live og tilføje pulsen til din rute."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain liest während eines Trainings Ihre Herzfrequenz, Distanz und Energie, um sie live anzuzeigen und die Herzfrequenz zu Ihrer Route hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Endurain διαβάζει τον καρδιακό ρυθμό, την απόσταση και την ενέργειά σας κατά τη διάρκεια μιας προπόνησης για να τα εμφανίζει σε πραγματικό χρόνο και να προσθέτει τον καρδιακό ρυθμό στη διαδρομή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain reads your heart rate, distance and energy during a workout to show them live and add heart rate to your route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain lee tu frecuencia cardíaca, distancia y energía durante un entrenamiento para mostrarlas en directo y añadir la frecuencia cardíaca a tu ruta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain loeb treeningu ajal teie pulssi, vahemaad ja energiat, et neid reaalajas näidata ja lisada pulss teie marsruudile."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain lukee sykkeesi, matkan ja energian harjoituksen aikana näyttääkseen ne reaaliajassa ja lisätäkseen sykkeen reittiisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain lit votre fréquence cardiaque, votre distance et votre énergie pendant un entraînement pour les afficher en direct et ajouter la fréquence cardiaque à votre itinéraire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain le a túa frecuencia cardíaca, distancia e enerxía durante un adestramento para amosalas en directo e engadir a frecuencia cardíaca á túa ruta."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain tijekom vježbe čita vaš puls, udaljenost i energiju kako bi ih prikazivao uživo i dodao puls vašoj ruti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Endurain edzés közben beolvassa a pulzusát, a távolságot és az energiát, hogy élőben megjelenítse őket, és hozzáadja a pulzust az útvonalához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain legge la frequenza cardiaca, la distanza e l’energia durante un allenamento per mostrarle in tempo reale e aggiungere la frequenza cardiaca al tuo percorso."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain treniruotės metu nuskaito jūsų pulsą, atstumą ir energiją, kad rodytų juos tiesiogiai ir pridėtų pulsą prie jūsų maršruto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain treniņa laikā nolasa jūsu pulsu, attālumu un enerģiju, lai tos rādītu reāllaikā un pievienotu pulsu jūsu maršrutam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain leser pulsen, distansen og energien din under en trening for å vise dem live og legge til pulsen i ruten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain leest tijdens een training je hartslag, afstand en energie om ze live te tonen en je hartslag aan je route toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain odczytuje Twoje tętno, dystans i energię podczas treningu, aby pokazywać je na żywo i dodawać tętno do Twojej trasy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain lê a sua frequência cardíaca, distância e energia durante um treino para as mostrar em tempo real e adicionar a frequência cardíaca ao seu percurso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain lê a sua frequência cardíaca, distância e energia durante um treino para as mostrar em tempo real e adicionar a frequência cardíaca ao seu percurso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain citește ritmul cardiac, distanța și energia în timpul unui antrenament pentru a le afișa în timp real și a adăuga ritmul cardiac la traseul dvs."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain počas tréningu číta váš tep, vzdialenosť a energiu, aby ich zobrazoval naživo a pridal tep k vašej trase."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain med vadbo bere vaš srčni utrip, razdaljo in energijo, da jih prikaže v živo in doda srčni utrip vaši poti."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain током вежбе чита ваш пулс, раздаљину и енергију да би их приказивао уживо и додао пулс вашој рути."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain läser din puls, sträcka och energi under ett träningspass för att visa dem i realtid och lägga till pulsen i din rutt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain, antrenman sırasında nabzınızı, mesafenizi ve enerjinizi canlı göstermek ve nabzı rotanıza eklemek için okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain під час тренування зчитує ваш пульс, відстань і енергію, щоб показувати їх у реальному часі та додавати пульс до вашого маршруту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain 会在锻炼期间读取你的心率、距离和能量，以便实时显示并将心率添加到你的路线中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain 會在鍛鍊期間讀取你的心率、距離和能量，以便即時顯示並將心率加入你的路線。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Health write permission prompt. 'Health' is Apple's Health app.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain запазва тренировките от часовника и техните маршрути в Health, както всяка тренировка, записана с Apple Watch."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain desa els entrenaments del rellotge i les seves rutes a Salut, com qualsevol entrenament enregistrat a l'Apple Watch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain ukládá tréninky z hodinek a jejich trasy do Zdraví, stejně jako jakýkoli trénink zaznamenaný na Apple Watch."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain gemmer dine træninger fra uret og deres ruter i Sundhed, ligesom enhver træning registreret på Apple Watch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain speichert Ihre Watch-Trainings und deren Routen in Health, wie jedes auf der Apple Watch aufgezeichnete Training."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Endurain αποθηκεύει τις προπονήσεις του ρολογιού και τις διαδρομές τους στην Υγεία, όπως κάθε προπόνηση που καταγράφεται στο Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain saves your watch workouts and their routes to Health, like any workout recorded on Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain guarda los entrenamientos del reloj y sus rutas en Salud, como cualquier entrenamiento registrado en el Apple Watch."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain salvestab teie kella treeningud ja nende marsruudid rakendusse Health nagu iga Apple Watchiga salvestatud treeningu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain tallentaa kellon harjoitukset ja niiden reitit Terveys-sovellukseen kuten minkä tahansa Apple Watchilla tallennetun harjoituksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain enregistre les entraînements de votre montre et leurs itinéraires dans Santé, comme tout entraînement enregistré sur Apple Watch."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain garda os adestramentos do reloxo e as súas rutas en Saúde, como calquera adestramento rexistrado no Apple Watch."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain sprema vježbe sa sata i njihove rute u aplikaciju Zdravlje, kao i svaku vježbu snimljenu na Apple Watchu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Endurain az órán rögzített edzéseket és útvonalaikat az Egészség alkalmazásba menti, mint bármely Apple Watchon rögzített edzést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain salva gli allenamenti dell’orologio e i relativi percorsi in Salute, come qualsiasi allenamento registrato su Apple Watch."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain išsaugo jūsų laikrodžio treniruotes ir jų maršrutus programoje Health, kaip ir bet kurią Apple Watch įrašytą treniruotę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain saglabā jūsu pulksteņa treniņus un to maršrutus lietotnē Health tāpat kā jebkuru Apple Watch ierakstītu treniņu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain lagrer klokketreningene dine og rutene deres i Helse, som enhver trening registrert på Apple Watch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain bewaart je trainingen op je horloge en hun routes in Gezondheid, net als elke training die op de Apple Watch is opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain zapisuje treningi z zegarka i ich trasy w aplikacji Zdrowie, jak każdy trening zarejestrowany na Apple Watch."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain guarda os treinos do relógio e os respetivos percursos na app Saúde, como qualquer treino gravado no Apple Watch."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain guarda os treinos do relógio e os respetivos percursos na app Saúde, como qualquer treino gravado no Apple Watch."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain salvează antrenamentele de pe ceas și traseele lor în Sănătate, ca orice antrenament înregistrat pe Apple Watch."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain ukladá tréningy z hodiniek a ich trasy do aplikácie Zdravie, rovnako ako akýkoľvek tréning zaznamenaný na Apple Watch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain shrani vadbe z ure in njihove poti v aplikacijo Health, tako kot vsako vadbo, posneto z uro Apple Watch."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain чува вежбе са сата и њихове руте у апликацији Здравље, као и сваку вежбу снимљену на Apple Watch уређају."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain sparar dina träningspass från klockan och deras rutter i Hälsa, precis som alla träningspass som registreras på Apple Watch."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain, saat antrenmanlarınızı ve rotalarını Apple Watch’ta kaydedilen her antrenman gibi Sağlık uygulamasına kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain зберігає тренування з годинника та їхні маршрути в застосунку «Здоровʼя», як і будь-яке тренування, записане на Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain 会将你的手表锻炼及其路线保存到“健康”，就像在 Apple Watch 上记录的任何锻炼一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain 會將你的手錶鍛鍊及其路線儲存到「健康」，就像在 Apple Watch 上記錄的任何鍛鍊一樣。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt (while in use).",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain записва маршрута ви по време на тренировки на открито, за да може да бъде качен на вашия сървър Endurain."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain enregistra la vostra ruta durant els entrenaments a l'aire lliure perquè es pugui penjar al vostre servidor Endurain."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain zaznamenává vaši trasu během venkovních tréninků, aby ji bylo možné nahrát na váš server Endurain."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain registrerer din rute under udendørs træning, så den kan uploades til din Endurain-server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain zeichnet Ihre Route bei Trainings im Freien auf, damit sie auf Ihren Endurain-Server hochgeladen werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Endurain καταγράφει τη διαδρομή σας κατά τις προπονήσεις σε εξωτερικό χώρο ώστε να μπορεί να μεταφορτωθεί στον διακομιστή Endurain σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain records your route during outdoor workouts so it can be uploaded to your Endurain server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain registra tu ruta durante los entrenamientos al aire libre para que se pueda subir a tu servidor de Endurain."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain salvestab välitreeningute ajal teie marsruudi, et selle saaks teie Endurain-serverisse üles laadida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain tallentaa reittisi ulkoharjoitusten aikana, jotta se voidaan ladata Endurain-palvelimellesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain enregistre votre itinéraire pendant les entraînements en extérieur afin qu’il puisse être envoyé vers votre serveur Endurain."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain rexistra a túa ruta durante os adestramentos ao aire libre para que se poida subir ao teu servidor de Endurain."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain bilježi vašu rutu tijekom vježbi na otvorenom kako bi se mogla prenijeti na vaš Endurain poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Endurain rögzíti az útvonalát a szabadtéri edzések során, hogy feltölthető legyen az Endurain-szerverére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain registra il tuo percorso durante gli allenamenti all’aperto in modo che possa essere caricato sul tuo server Endurain."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain įrašo jūsų maršrutą lauko treniruočių metu, kad jį būtų galima įkelti į jūsų Endurain serverį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain ieraksta jūsu maršrutu āra treniņu laikā, lai to varētu augšupielādēt jūsu Endurain serverī."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain registrerer ruten din under utendørstreninger slik at den kan lastes opp til Endurain-serveren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain neemt je route op tijdens buitentrainingen zodat deze naar je Endurain-server kan worden geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain rejestruje Twoją trasę podczas treningów na zewnątrz, aby można ją było przesłać na Twój serwer Endurain."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain grava o seu percurso durante treinos ao ar livre para que possa ser enviado para o seu servidor Endurain."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Endurain grava o seu percurso durante treinos ao ar livre para que possa ser enviado para o seu servidor Endurain."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain înregistrează traseul în timpul antrenamentelor în aer liber, astfel încât să poată fi încărcat pe serverul dvs. Endurain."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain zaznamenáva vašu trasu počas vonkajších tréningov, aby ju bolo možné nahrať na váš server Endurain."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain med vadbami na prostem beleži vašo pot, da jo je mogoče naložiti na vaš strežnik Endurain."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain снима вашу руту током вежби на отвореном да би могла да се отпреми на ваш Endurain сервер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
