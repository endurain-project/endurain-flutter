    "Location is off for Endurain. Workouts without a GPS route can't be uploaded yet." : {
      "comment" : "Shown on the start screen when location access is denied.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположението е изключено за Endurain. Тренировки без GPS маршрут все още не могат да бъдат качени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicació està desactivada per a Endurain. Els entrenaments sense ruta GPS encara no es poden penjar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poloha je pro Endurain vypnutá. Tréninky bez trasy GPS zatím nelze nahrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placering er slået fra for Endurain. Træning uden GPS-rute kan endnu ikke uploades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort ist für Endurain deaktiviert. Trainings ohne GPS-Route können noch nicht hochgeladen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία είναι απενεργοποιημένη για το Endurain. Οι προπονήσεις χωρίς διαδρομή GPS δεν μπορούν ακόμη να μεταφορτωθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está desactivada para Endurain. Los entrenamientos sin ruta GPS aún no se pueden subir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asukoht on Endurainil välja lülitatud. GPS-marsruudita treeninguid ei saa veel üles laadida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijainti on pois päältä Endurainilta. Harjoituksia ilman GPS-reittiä ei voi vielä ladata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La localisation est désactivée pour Endurain. Les entraînements sans itinéraire GPS ne peuvent pas encore être envoyés."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localización está desactivada para Endurain. Os adestramentos sen ruta GPS aínda non se poden subir."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokacija je isključena za Endurain. Vježbe bez GPS rute još se ne mogu prenijeti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helymeghatározás ki van kapcsolva az Endurain számára. A GPS-útvonal nélküli edzések még nem tölthetők fel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione è disattivata per Endurain. Gli allenamenti senza percorso GPS non possono ancora essere caricati."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain vietos nustatymas išjungtas. Treniruočių be GPS maršruto kol kas negalima įkelti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurain atrašanās vieta ir izslēgta. Treniņus bez GPS maršruta vēl nevar augšupielādēt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjon er slått av for Endurain. Treninger uten GPS-rute kan ikke lastes opp ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatie staat uit voor Endurain. Trainingen zonder gps-route kunnen nog niet worden geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja jest wyłączona dla Endurain. Treningów bez trasy GPS nie można jeszcze przesłać."
          }
        },
        "pt" : {
          "stringUnit" : {
