    "No GPS route was recorded, so this workout can't be uploaded yet. It stays saved in Health." : {
      "comment" : "Summary note when the workout has no route. 'Health' is Apple's Health app.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е записан GPS маршрут, затова тази тренировка все още не може да бъде качена. Тя остава запазена в Health."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha enregistrat cap ruta GPS, de manera que aquest entrenament encara no es pot penjar. Continua desat a Salut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebyla zaznamenána žádná trasa GPS, takže tento trénink zatím nelze nahrát. Zůstává uložený ve Zdraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
