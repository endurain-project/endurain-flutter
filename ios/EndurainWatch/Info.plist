<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt-PT</string>
		<string>pt</string>
		<string>bg</string>
		<string>ca</string>
		<string>cs</string>
		<string>da</string>
		<string>de</string>
		<string>el</string>
		<string>es</string>
		<string>et</string>
		<string>fi</string>
		<string>fr</string>
		<string>gl</string>
		<string>hr</string>
		<string>hu</string>
		<string>it</string>
		<string>lt</string>
		<string>lv</string>
		<string>nb</string>
		<string>nl</string>
		<string>pl</string>
		<string>ro</string>
		<string>sk</string>
		<string>sl</string>
		<string>sr</string>
		<string>sv</string>
		<string>tr</string>
		<string>uk</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Endurain</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Endurain reads your heart rate and distance during a workout to show them live and add heart rate to your route.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Endurain saves your watch workouts and their routes to Health, like any workout recorded on Apple Watch.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Endurain records your route during outdoor workouts so it can be uploaded to your Endurain server.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>EndurainWorkoutRoute</key>
		<string>Endurain needs your precise location to record an accurate route of your workout.</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<!-- The app plays no audio. Apple requires this mode for haptics during
		     a workout session ("If your app plays audio or provides haptic
		     feedback during the workout session, you must also add the Audio
		     background mode"): the start countdown taps the wrist while its
		     prepared session keeps the app running with the wrist lowered,
		     and the start is confirmed with a tap. -->
		<string>audio</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<!-- Must equal the iPhone app's bundle identifier. Flutter also reads it to
	     detect the companion app and build without a fixed iOS SDK. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.endurain.endurain</string>
</dict>
</plist>
