{
  "description": "Shared SessionTiming vectors. Loaded by the Kotlin and Swift tests (the Dart geolocator recorder computes the same value inline). 'elapsedCases' check SessionTiming.elapsedSeconds(session, referenceMillis); 'interruptionCases' check SessionTiming.afterInterruption(session, lastPointMillis, nowMillis) against the listed fields of the returned session ('expect.resumedAt' is the ISO-8601 UTC string with milliseconds, and an untouched session echoes its input). Timestamps are ISO-8601 UTC; millis are epoch milliseconds.",
  "elapsedCases": [
    {
      "name": "recording counts from startedAt",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 0
      },
      "referenceMillis": 1772359325000,
      "elapsedSeconds": 125
    },
    {
      "name": "recording counts from resumedAt when present",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": "2026-03-01T10:10:00.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 300
      },
      "referenceMillis": 1772359890000,
      "elapsedSeconds": 390
    },
    {
      "name": "paused keeps the stored value",
      "session": {
        "status": "paused",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 300
      },
      "referenceMillis": 1772360199000,
      "elapsedSeconds": 300
    },
    {
      "name": "stopping keeps the stored value",
      "session": {
        "status": "stopping",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 42
      },
      "referenceMillis": 1772360199000,
      "elapsedSeconds": 42
    },
    {
      "name": "completed keeps the stored value",
      "session": {
        "status": "completed",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 77
      },
      "referenceMillis": 1772360199000,
      "elapsedSeconds": 77
    },
    {
      "name": "reference before the anchor adds nothing",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 10
      },
      "referenceMillis": 1772359140000,
      "elapsedSeconds": 10
    },
    {
      "name": "partial seconds are truncated",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 5
      },
      "referenceMillis": 1772359259999,
      "elapsedSeconds": 64
    },
    {
      "name": "fractional seconds in the timestamp are ignored",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.900Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 0
      },
      "referenceMillis": 1772359210000,
      "elapsedSeconds": 10
    },
    {
      "name": "unparseable anchor falls back to the stored value",
      "session": {
        "status": "recording",
        "startedAt": "not a date",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 33
      },
      "referenceMillis": 1772359700000,
      "elapsedSeconds": 33
    },
    {
      "name": "empty resumedAt falls back to the stored value",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": "",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 21
      },
      "referenceMillis": 1772359700000,
      "elapsedSeconds": 21
    },
    {
      "name": "crosses midnight and a month boundary",
      "session": {
        "status": "recording",
        "startedAt": "2026-02-28T23:59:30.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 0
      },
      "referenceMillis": 1772323230000,
      "elapsedSeconds": 60
    }
  ],
  "interruptionCases": [
    {
      "name": "uses the last point as the end of the lost segment",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 60
      },
      "lastPointMillis": 1772359300000,
      "nowMillis": 1772359700000,
      "expect": {
        "status": "recording",
        "resumedAt": "2026-03-01T10:08:20.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 160
      }
    },
    {
      "name": "falls back to the segment anchor without a last point",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 60
      },
      "lastPointMillis": null,
      "nowMillis": 1772359700000,
      "expect": {
        "status": "recording",
        "resumedAt": "2026-03-01T10:08:20.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 60
      }
    },
    {
      "name": "falls back to now when the anchor is unparseable",
      "session": {
        "status": "recording",
        "startedAt": "bad",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 60
      },
      "lastPointMillis": null,
      "nowMillis": 1772359700000,
      "expect": {
        "status": "recording",
        "resumedAt": "2026-03-01T10:08:20.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 60
      }
    },
    {
      "name": "clears pause and end markers",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": "2026-03-01T10:01:00.000Z",
        "endedAt": "2026-03-01T10:02:00.000Z",
        "elapsedDurationSeconds": 5
      },
      "lastPointMillis": 1772359230000,
      "nowMillis": 1772359290000,
      "expect": {
        "status": "recording",
        "resumedAt": "2026-03-01T10:01:30.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 35
      }
    },
    {
      "name": "a paused session is untouched",
      "session": {
        "status": "paused",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": "2026-03-01T10:05:00.000Z",
        "endedAt": null,
        "elapsedDurationSeconds": 200
      },
      "lastPointMillis": 1772359230000,
      "nowMillis": 1772359290000,
      "expect": {
        "status": "paused",
        "resumedAt": null,
        "pausedAt": "2026-03-01T10:05:00.000Z",
        "endedAt": null,
        "elapsedDurationSeconds": 200
      }
    },
    {
      "name": "a completed session is untouched",
      "session": {
        "status": "completed",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": "2026-03-01T10:05:00.000Z",
        "elapsedDurationSeconds": 200
      },
      "lastPointMillis": null,
      "nowMillis": 1772359290000,
      "expect": {
        "status": "completed",
        "resumedAt": null,
        "pausedAt": null,
        "endedAt": "2026-03-01T10:05:00.000Z",
        "elapsedDurationSeconds": 200
      }
    },
    {
      "name": "last point earlier than the anchor adds nothing",
      "session": {
        "status": "recording",
        "startedAt": "2026-03-01T10:00:00.000Z",
        "resumedAt": "2026-03-01T10:10:00.000Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 100
      },
      "lastPointMillis": 1772359200000,
      "nowMillis": 1772360400250,
      "expect": {
        "status": "recording",
        "resumedAt": "2026-03-01T10:20:00.250Z",
        "pausedAt": null,
        "endedAt": null,
        "elapsedDurationSeconds": 100
      }
    }
  ]
}
