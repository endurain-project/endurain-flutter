{
  "description": "Shared MovementAutoPauseDetector vectors. Loaded by the Dart, Kotlin and Swift detector tests so the three implementations cannot drift. Times are seconds from the reset anchor (t=0); a step omits lat/lon/speed/accuracy to use 38.7 / -9.1 / no speed / 5 m.",
  "cases": [
    {
      "name": "disabled config never auto-pauses",
      "config": { "enabled": false, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 1, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 10, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 60, "speed": 0, "expect": "none" }
      ]
    },
    {
      "name": "auto-pauses once stillness reaches the delay",
      "config": { "enabled": true, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 1, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 4, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 5, "speed": 0, "expect": "autoPause" }
      ]
    },
    {
      "name": "reported speed above the threshold resets the stillness timer",
      "config": { "enabled": true, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 3, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 4, "speed": 2, "expect": "none" },
        { "mode": "active", "t": 8, "speed": 0, "expect": "none" },
        { "mode": "active", "t": 9, "speed": 0, "expect": "autoPause" }
      ]
    },
    {
      "name": "unreliable accuracy is never counted as movement",
      "config": { "enabled": true, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 1, "speed": 10, "accuracy": 500, "expect": "none" },
        { "mode": "active", "t": 5, "speed": 0, "expect": "autoPause" }
      ]
    },
    {
      "name": "displacement-derived speed is used when reported speed is absent",
      "config": { "enabled": true, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 0, "lat": 38.7, "expect": "none" },
        { "mode": "active", "t": 1, "lat": 38.7009, "expect": "none" },
        { "mode": "active", "t": 2, "lat": 38.7009, "expect": "none" },
        { "mode": "active", "t": 6, "lat": 38.7009, "expect": "autoPause" }
      ]
    },
    {
      "name": "speedless jitter within the accuracy radius is not movement",
      "config": { "enabled": true, "pauseDelaySeconds": 5 },
      "steps": [
        { "mode": "active", "t": 0, "lat": 38.7, "expect": "none" },
        { "mode": "active", "t": 1, "lat": 38.70003, "expect": "none" },
        { "mode": "active", "t": 2, "lat": 38.7, "expect": "none" },
        { "mode": "active", "t": 5, "lat": 38.70003, "expect": "autoPause" }
      ]
    },
    {
      "name": "auto-resumes only after enough consecutive moving samples",
      "config": { "enabled": true, "pauseDelaySeconds": 5, "consecutiveMovingSamplesToResume": 3 },
      "steps": [
        { "mode": "paused", "t": 1, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 2, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 3, "speed": 2, "expect": "autoResume" }
      ]
    },
    {
      "name": "a single still sample resets the consecutive-moving counter",
      "config": { "enabled": true, "pauseDelaySeconds": 5, "consecutiveMovingSamplesToResume": 3 },
      "steps": [
        { "mode": "paused", "t": 1, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 2, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 3, "speed": 0, "expect": "none" },
        { "mode": "paused", "t": 4, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 5, "speed": 2, "expect": "none" },
        { "mode": "paused", "t": 6, "speed": 2, "expect": "autoResume" }
      ]
    },
    {
      "name": "unreliable samples never count toward auto-resume",
      "config": { "enabled": true, "pauseDelaySeconds": 5, "consecutiveMovingSamplesToResume": 3 },
      "steps": [
        { "mode": "paused", "t": 1, "speed": 5, "accuracy": 500, "expect": "none" },
        { "mode": "paused", "t": 2, "speed": 5, "accuracy": 500, "expect": "none" },
        { "mode": "paused", "t": 3, "speed": 5, "accuracy": 500, "expect": "none" },
        { "mode": "paused", "t": 4, "speed": 5, "accuracy": 500, "expect": "none" }
      ]
    }
  ]
}
