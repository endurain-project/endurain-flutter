{
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "30 days",
  "dependencyDashboard": true,
  "pinDigests": true,
  "hostRules": [
    {
      "matchHost": "data.forgejo.org",
      "hostType": "github"
    }
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependency updates"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "matchCategories": [
        "security"
      ],
      "labels": [
        "dependencies",
        "security"
      ],
      "prPriority": 10,
      "groupName": "security updates",
      "dependencyDashboardApproval": false
    }
  ]
}
