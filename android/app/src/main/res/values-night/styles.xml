<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark parents of the base themes in values/styles.xml (OS Dark Mode on). -->
    <style name="BaseLaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="BaseNormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
