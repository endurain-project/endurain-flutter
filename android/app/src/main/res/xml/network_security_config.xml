<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for Endurain on Android.

  Self-hosted instances are user-provided hosts that may be reached over plain
  HTTP (the login flow warns before connecting), so cleartext is permitted by
  the base config. The Dart transport layer (AppConfig.cloudBaseUrl /
  ServerUrlResolver) already enforces HTTPS for the managed "Endurain Cloud"
  origin; the domain-config below adds defense-in-depth at the OS layer so the
  cloud origin can never be reached over cleartext even if a stored http:// URL
  is present. This mirrors the iOS ATS exception domain in
  ios/Runner/Info.plist.

  When the managed domain is finalized, replace the placeholder host below with
  it and keep it in sync with AppConfig.cloudBaseUrl and the iOS Info.plist
  NSExceptionDomains entry.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">app.endurain.example</domain>
    </domain-config>
</network-security-config>
