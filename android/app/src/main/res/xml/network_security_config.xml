<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for Endurain on Android.

  Self-hosted instances are user-provided hosts that may be reached over plain
  HTTP (the login flow warns before connecting), so cleartext is permitted by
  the base config.

  There is no managed ("Endurain Cloud") service yet. When one exists, add a
  domain-config with cleartextTrafficPermitted="false" for its host here, add
  the matching NSExceptionDomains entry to ios/Runner/Info.plist, and build with
  the ENDURAIN_CLOUD_BASE_URL dart-define set to that origin. Until all three
  agree, test/architecture/android_manifest_test.dart fails.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
