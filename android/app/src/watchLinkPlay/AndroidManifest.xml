<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app manifest only when the Wear OS link is built in
     (the default; -Pendurain.wearable=false leaves it out). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported for Google Play Services, which only delivers data items
             published by an app with the same package name and signature. -->
        <service
            android:name=".watch.WatchDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/endurain/handoff"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
